# ------------------------------------------------------------------
# LENA HOME — орчны тохиргоо (.env.local болгож хуулна)
# ------------------------------------------------------------------

# Админы эхний нэвтрэлт (эхний ажиллуулалтад DB-д бүртгэгдэнэ)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=LenaHome2026

# Сессийн cookie-г гарын үсгэх нууц (production-д заавал урт санамсаргүй утга)
ADMIN_SESSION_SECRET=please-change-this-to-a-long-random-string

# AI COLOR MATCH — зураг харах AI (сонголтоор).
# Тохируулаагүй үед систем зургийн өнгөний палитраар ажиллана.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Сайтын хаяг (SEO metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Мэдээллийн сан, swatch зургийн хадгалах хавтас
LENA_DATA_DIR=./data
